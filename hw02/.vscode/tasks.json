{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: gcc build readings",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "${workspaceFolder}/histogram.c",
                "${workspaceFolder}/readings.c",
                "${workspaceFolder}/stats.c",
                "${workspaceFolder}/main.c",
                "-o",
                "${workspaceFolder}/main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
